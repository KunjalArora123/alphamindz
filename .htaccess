<IfModule mod_rewrite.c>
    RewriteEngine On

    # Redirect all HTTP traffic to HTTPS safely (works directly and behind reverse proxies/CDNs)
    RewriteCond %{HTTPS} !on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Auto-append nocache=1 to homepage and sensitive dynamic routes if query string is empty
    RewriteCond %{REQUEST_METHOD} GET
    RewriteCond %{QUERY_STRING} ^$
    RewriteCond %{REQUEST_URI} ^/AlphaMindz/?$ [NC,OR]
    RewriteCond %{REQUEST_URI} ^/?$ [OR]
    RewriteCond %{REQUEST_URI} ^/AlphaMindz/(student|admin|superadmin|auth|cart)(/.*)?$ [NC,OR]
    RewriteCond %{REQUEST_URI} ^/(student|admin|superadmin|auth|cart)(/.*)?$ [NC]
    RewriteRule ^ %{REQUEST_URI}?nocache=1 [R=302,L,QSA]

    # CodeIgniter routing
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php/$1 [L]
</IfModule>

# Security & Cache-Control Headers
<IfModule mod_headers.c>
    # Automatically upgrade any insecure HTTP image/media/script requests to HTTPS
    Header always set Content-Security-Policy "upgrade-insecure-requests;"

    # Default: force no-store / no-cache for all dynamic responses across browsers, CDNs, and proxies
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0, post-check=0, pre-check=0, private"
    Header set Pragma "no-cache"
    Header set Expires "Thu, 01 Jan 1970 00:00:00 GMT"

    # Only allow caching for true static files (css, js, images, fonts, pdf, media)
    <FilesMatch "\.(css|js|png|jpg|jpeg|gif|ico|svg|webp|pdf|zip|mp4|webm|woff|woff2|ttf|eot)$">
        Header set Cache-Control "public, max-age=86400, must-revalidate"
        Header unset Pragma
        Header unset Expires
    </FilesMatch>
</IfModule>
